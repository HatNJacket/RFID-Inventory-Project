<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.telcan.rfidsweep"
    android:versionCode="102"
    android:versionName="3.84">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update: the app downloads its own new APK from the server and
         hands it to the system installer (one-time user grant on-device). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="TC RFID Sweep"
        android:extractNativeLibs="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- PackageInstaller status callback for the self-update flow -->
        <receiver
            android:name=".MainActivity$InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
